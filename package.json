{
	"name": "obsidian-auto-glossary",
	"version": "1.0.0",
	"description": "Obsidian plugin to automatically create and organize indexes (MOCs), glossaries, or combined glossary indexes from folders.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node --import tsx --test ./test/*.ts",
		"test:coverage": "c8 node --import tsx --test ./test/*.ts",
		"test:only": "node --import tsx --test --test-only ./test/*.ts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"glossary",
		"index",
		"moc"
	],
	"author": "Ennio Italiano",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ennioitaliano/obsidian-auto-glossary"
	},
	"devDependencies": {
		"@types/lodash": "^4.17.16",
		"@types/node": "^20.17.24",
		"@types/sinon": "^17.0.4",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"builtin-modules": "^3.3.0",
		"c8": "^10.1.3",
		"esbuild": "^0.25.4",
		"lodash": "^4.17.21",
		"obsidian": "^1.7.2",
		"sinon": "^18.0.1",
		"tslib": "^2.8.1",
		"tsx": "^4.19.4",
		"typescript": "^5.4.5"
	}
}

